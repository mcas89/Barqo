# Firebase — preencha quando tiver as chaves do console
# https://console.firebase.google.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Ambiente
VITE_APP_ENV=development

# InfinitePay Checkout Integrado (InfiniteTag sem o $)
VITE_INFINITEPAY_HANDLE=

# Gateway de pagamento atual. Troque depois sem alterar a tela de Planos.
VITE_PAYMENT_GATEWAY=infinitepay
