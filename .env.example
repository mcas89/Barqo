# Firebase — só para desenvolvimento local (npm run dev)
# Produção usa `.env.production`, que vai no GitHub.
# https://console.firebase.google.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Ambiente
VITE_APP_ENV=development

# InfinitePay Checkout Integrado (InfiniteTag sem o $)
VITE_INFINITEPAY_HANDLE=

# Gateway de pagamento atual. Troque depois sem alterar a tela de Planos.
VITE_PAYMENT_GATEWAY=infinitepay

# Agente local de impressão (ESC/POS / caminho da impressora).
# Se vazio, o cupom abre na janela de impressão do navegador.
VITE_PRINT_AGENT_URL=

# API futura de envio de comprovante (e-mail/WhatsApp).
# Se vazio e o envio estiver ligado, o comprovante fica na fila local.
VITE_RECEIPT_API_URL=
