rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isOwner(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }

    function canAccessOrg(orgId) {
      return isMember(orgId) || isOwner(orgId);
    }

    function orgBillingFieldsUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('planId', '') == resource.data.get('planId', '');
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /organizations/{orgId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow read: if canAccessOrg(orgId);
      allow update: if isOwner(orgId)
        || (canAccessOrg(orgId) && orgBillingFieldsUnchanged());
      allow delete: if isOwner(orgId);

      match /members/{memberId} {
        allow read: if canAccessOrg(orgId);
        allow create, update, delete: if isOwner(orgId);
      }

      match /products/{productId} {
        allow read, write: if canAccessOrg(orgId);
      }

      match /categories/{categoryId} {
        allow read, write: if canAccessOrg(orgId);
      }

      match /sales/{saleId} {
        allow read, write: if canAccessOrg(orgId);
      }

      match /stock_movements/{movementId} {
        allow read, write: if canAccessOrg(orgId);
      }

      match /cash_sessions/{sessionId} {
        allow read, write: if canAccessOrg(orgId);
      }

      match /employees/{employeeId} {
        allow read, write: if canAccessOrg(orgId);
      }

      match /customers/{customerId} {
        allow read, write: if canAccessOrg(orgId);
      }

      match /receivables/{receivableId} {
        allow read, write: if canAccessOrg(orgId);
      }

      match /suppliers/{supplierId} {
        allow read, write: if canAccessOrg(orgId);
      }

      match /devices/{deviceId} {
        allow read, write: if canAccessOrg(orgId);
      }

      match /operator_sessions/{sessionId} {
        allow read, write: if canAccessOrg(orgId);
      }

      match /audit_events/{eventId} {
        allow read, write: if canAccessOrg(orgId);
      }

      match /pin_attempts/{attemptId} {
        allow read, create: if canAccessOrg(orgId);
        allow update, delete: if false;
      }

      match /billing_orders/{orderId} {
        allow read: if canAccessOrg(orgId);
        allow create, update: if isOwner(orgId);
        allow delete: if false;
      }
    }

    match /subscriptions/{orgId} {
      allow read: if canAccessOrg(orgId);
      allow create, update: if isOwner(orgId);
      allow delete: if false;
    }
  }
}
